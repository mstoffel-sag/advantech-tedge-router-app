#!/bin/sh
# tedge-persist -- carry everything the OPERATOR owns across a Router App upgrade.
#
#   tedge-persist baseline      record what this version ships (install, pristine tree)
#   tedge-persist baseline-add  record what the app itself created during install
#   tedge-persist baseline-seal record what thin-edge generates at its first run
#                               (once per install; from etc/init after a start)
#   tedge-persist save          persist every file that is new or changed since then
#   tedge-persist restore       put those files back (install, after `baseline`)
#   tedge-persist status        show what is held
#
# WHY: ICR-OS replaces /opt/<module> wholesale on every upgrade. Everything the
# app ships comes back -- everything the operator added or changed inside that
# tree is destroyed, and nothing in the platform notices.
#
# WHY A DIFF AND NOT A LIST: this script used to carry a hand-maintained list of
# files, and the list is what failed. It named etc/{metrics,relay,container,
# parameters,settings} and the operator's flows, and silently missed
# plugins/tedge-configuration-plugin.toml -- the file that decides what
# Cumulocity may read and write at all. The upgrade LOOKED healthy (the bundle
# ships base entries and etc/install re-adds the app's own), while every entry
# the operator had added was gone. Looking for that one file turned up three
# more in the same hole, one of them mappers/c8y/mapper.toml, where thin-edge
# 2.x actually keeps the cloud connection. A list only ever covers the files
# somebody remembered, and nothing tells you when it has fallen behind.
#
# So the app records, at install time, a BASELINE of what it ships, and `save`
# persists every file in the configuration surface that is missing from the
# baseline (the operator added it) or differs from it (the operator changed it).
# Nothing has to be enumerated in advance: a file a future version introduces is
# covered the day it exists, as is a file the operator drops in.
#
# It also makes carrying app plumbing safe. system.toml and env are in the
# surface, but an untouched copy is identical to the baseline and is therefore
# NOT carried -- so a fix this app ships in them is never frozen at the version
# the router was first installed with. Only a file you actually edited follows
# you, and where this version ships something different it is kept beside yours
# as <file>.dist.
#
# The store is /opt/tedge-data/persist -- the same partition and the same
# self-cleaning guard as the device certificate (see etc/install): it survives
# an upgrade because it is outside the module tree, and is removed on a genuine
# delete by /opt/tedge-data/etc/init.
#
# `save` runs from etc/uninstall (which ICR-OS also runs on an upgrade, right
# before the tree is replaced) and from etc/init stop, so an interrupted upgrade
# still has a recent copy. `baseline`, `restore` and `baseline-add` run from
# etc/install, in that order, and `baseline-seal` from etc/init after the first
# start that follows an install.
set -u

MOD_DIR=/opt/tedge
PERSIST=/opt/tedge-data/persist
STORE=$PERSIST/files          # the operator's files, keyed by path relative to MOD_DIR
BASE=$PERSIST/baseline        # what the installed version ships, same layout
SEAL=$PERSIST/.baseline-sealed # set once the runtime-generated files are in it
RESTORED=$PERSIST/.restored   # what the last restore put back: the operator's, definitively
TMPL=/tmp/.tedge-persist.$$   # scratch file lists

# The configuration surface: where operator-owned content can legitimately live.
# Deliberately NOT included: bin/, www/, services/, services-init.d/ (app code --
# a modified copy is a local patch, not configuration, and carrying it across an
# upgrade would defeat the upgrade), ca-certificates.crt (would pin an outdated
# root store), and the runtime/state entries (.agent/, mosquitto.db,
# mosquitto-conf/, device/, credentials.toml -- all regenerated, and the last
# two hold secrets that etc/settings already carries).
SURFACE_DIRS="etc plugins operations mappers parameter-plugins sm-plugins log-plugins config-plugins diag-plugins bootstrap.d"
SURFACE_FILES="tedge.toml system.toml env"

log() { echo "tedge-persist: $1"; }

# `[ -e ]` FOLLOWS symlinks, so a link whose target does not exist (yet) tests
# as absent -- which made sm-plugins/container look operator-added on every save.
# Ask about the entry itself.
exists() { [ -e "$1" ] || [ -L "$1" ]; }

# Did the last restore put this path back? Then it is the operator's.
is_restored() { grep -qx "$1" "$RESTORED" 2>/dev/null; }

cleanup() { rm -f "$TMPL" "$TMPL.raw"; }
trap cleanup EXIT

# ICR-OS busybox has no diff and no md5sum/sha*sum -- but it does have cmp.
# Symlinks are compared by target, since cmp would follow them (sm-plugins/ is a
# directory of symlinks, and the mapper symlinks operations/c8y/<op> to a
# .template).
same_file() {
    if [ -L "$1" ] || [ -L "$2" ]; then
        [ "$(readlink "$1" 2>/dev/null)" = "$(readlink "$2" 2>/dev/null)" ]
    else
        cmp -s "$1" "$2" 2>/dev/null
    fi
}

# Paths this script must never carry, relative to MOD_DIR.
excluded() {
    case "$1" in
        *.dist|*.tmp|*.tmp.*|*.bak|*.bak-*|*~) return 0 ;;
        .*|*/.*)                               return 0 ;;   # dot files and dot dirs
    esac
    # The mapper GENERATES its built-in flows as flat *.toml files under
    # mappers/<mapper>/flows/ at runtime (alarms.toml, units.toml, ...). They are
    # not in the package, so they would look operator-added forever, and a stale
    # copy would mask what a new version generates. A flow installed from
    # Cumulocity is a DIRECTORY there -- that one is the operator's, and is kept.
    case "$1" in
        mappers/*/flows/*)
            rest=${1#mappers/*/flows/}
            case "$rest" in
                */*) return 1 ;;
                *)   return 0 ;;
            esac
            ;;
    esac
    return 1
}

# List the surface of <root> into $TMPL, as paths relative to <root>.
# Two finds rather than one with -o: busybox takes both and this needs no
# parenthesis quoting.
surface_of() {   # surface_of <root>
    root=$1
    : > "$TMPL"
    : > "$TMPL.raw"
    for d in $SURFACE_DIRS; do
        [ -d "$root/$d" ] || continue
        find "$root/$d" -type f >> "$TMPL.raw" 2>/dev/null
        find "$root/$d" -type l >> "$TMPL.raw" 2>/dev/null
    done
    for f in $SURFACE_FILES; do
        exists "$root/$f" && echo "$root/$f" >> "$TMPL.raw"
    done
    while read -r p; do
        rel=${p#"$root"/}
        excluded "$rel" || echo "$rel" >> "$TMPL"
    done < "$TMPL.raw"
    rm -f "$TMPL.raw"
    return 0
}

copy_into() {   # copy_into <src-root> <dest-root> <relpath>
    mkdir -p "$2/$(dirname "$3")" 2>/dev/null || return 1
    cp -a "$1/$3" "$2/$3" 2>/dev/null
}

count_files() {   # count_files <dir>
    [ -d "$1" ] || { echo 0; return 0; }
    { find "$1" -type f; find "$1" -type l; } 2>/dev/null | wc -l
}

# ---------------------------------------------------------------------------
# baseline -- what this version ships. Taken on a pristine tree (etc/install
# runs it before restoring anything), so it is the reference `save` compares to.
# ---------------------------------------------------------------------------
baseline() {
    mkdir -p "$PERSIST" 2>/dev/null || true
    chmod 700 "$PERSIST" 2>/dev/null || true
    surface_of "$MOD_DIR"
    rm -rf "$BASE.new"
    mkdir -p "$BASE.new" 2>/dev/null || return 1
    while read -r rel; do
        copy_into "$MOD_DIR" "$BASE.new" "$rel"
    done < "$TMPL"
    rm -rf "$BASE"
    mv "$BASE.new" "$BASE" || return 1
    rm -f "$SEAL"        # this version has yet to record what it generates at run time
    log "recorded $(count_files "$BASE") shipped file(s) as this version's baseline"
}

# baseline-add -- files the APP creates after the baseline is taken: the
# sm-plugin symlinks, the entries etc/install registers in the plugin TOMLs.
# Without this they would look operator-added at the next save.
#
# What is NOT adopted is what `restore` just put back -- that is the operator's,
# and adopting it would silently drop it from the next save. The test is the
# restore list, not "is it in the store": the store can also hold files an
# earlier `save` picked up before the baseline was sealed (a stop during the
# very first start, for instance), and those must still be adoptable.
baseline_add() {
    [ -d "$BASE" ] || return 0
    surface_of "$MOD_DIR"
    n=0
    while read -r rel; do
        exists "$BASE/$rel" && continue
        is_restored "$rel" && continue
        copy_into "$MOD_DIR" "$BASE" "$rel" && n=$((n + 1))
    done < "$TMPL"
    [ "$n" -gt 0 ] && log "adopted $n file(s) created during install into the baseline"
    return 0
}

# baseline-seal -- what THIN-EDGE writes the first time it runs: the workflow
# files it renders from operations/*.toml.template, the built-in operations it
# writes into operations/c8y/, mappers/<cloud>/mapper.toml, the bridge rules.
# Some of those do not exist while etc/install is running (so the baseline cannot
# contain them) and some it ships and then REWRITES (so the baseline no longer
# matches). Either way every one of them looks operator-owned, and on the next
# upgrade that hands the router last version's plumbing back.
#
# Done ONCE per install (etc/init calls it at the end of a start; `baseline`
# clears the seal for the next version), and never for a file that is already in
# the store: that one is the operator's, and adopting it would silently drop it
# from the next save. Anything generated later than the first start is carried
# instead of adopted -- harmless, it lands beside the new version's copy as
# <file>.dist.
# ---------------------------------------------------------------------------
baseline_seal() {
    [ -d "$BASE" ] || return 0
    [ -f "$SEAL" ] && return 0
    surface_of "$MOD_DIR"
    n=0
    while read -r rel; do
        # What `restore` put back is the operator's: leave the baseline alone
        # for those, or the next save would drop them.
        is_restored "$rel" && continue
        # Everything else is this app's own, whatever it looks like now -- so
        # RE-RECORD it, not just add it when missing. thin-edge rewrites files
        # it also ships (operations/c8y/c8y_SoftwareUpdate and friends,
        # mappers/<cloud>/mapper.toml) the first time it runs; those are in the
        # baseline but no longer match it, and without this they would be
        # carried across every upgrade as if the operator had edited them --
        # handing the router its old plumbing back.
        exists "$BASE/$rel" && same_file "$BASE/$rel" "$MOD_DIR/$rel" && continue
        rm -rf "$BASE/$rel" 2>/dev/null
        copy_into "$MOD_DIR" "$BASE" "$rel" && n=$((n + 1))
    done < "$TMPL"
    : > "$SEAL"
    log "baseline sealed for this version ($n file(s) adopted or refreshed)"
}

# ---------------------------------------------------------------------------
# save -- everything in the surface that is new or changed since the baseline.
# ---------------------------------------------------------------------------
save() {
    mkdir -p "$PERSIST" 2>/dev/null || true
    chmod 700 "$PERSIST" 2>/dev/null || true

    if [ ! -d "$BASE" ]; then
        # This tree was installed by a version that recorded no baseline
        # (<= 1.0.19). Fall back to that version's fixed list: treating the whole
        # tree as operator content and restoring it over a new version would
        # freeze the entire configuration surface.
        log "no baseline recorded; falling back to the known list"
        save_legacy
        return 0
    fi

    surface_of "$MOD_DIR"
    rm -rf "$STORE.new"
    mkdir -p "$STORE.new" 2>/dev/null || return 1
    n=0
    while read -r rel; do
        if exists "$BASE/$rel" && same_file "$BASE/$rel" "$MOD_DIR/$rel"; then
            continue                      # untouched -- this version ships it
        fi
        copy_into "$MOD_DIR" "$STORE.new" "$rel" && n=$((n + 1))
    done < "$TMPL"
    # Mirror, so a file the operator has since reverted or deleted does not come
    # back from an older save.
    rm -rf "$STORE"
    mv "$STORE.new" "$STORE" 2>/dev/null || mkdir -p "$STORE"
    chmod 600 "$STORE/etc/settings" 2>/dev/null || true
    log "saved $n file(s) you added or changed"
}

# The <= 1.0.19 list, kept only for the no-baseline case above.
save_legacy() {
    rm -rf "$STORE.new"
    mkdir -p "$STORE.new" 2>/dev/null || return 1
    n=0
    for rel in etc/metrics etc/relay etc/container etc/parameters etc/settings \
               plugins/tedge-configuration-plugin.toml plugins/tedge-log-plugin.toml \
               plugins/tedge-container-plugin.toml tedge.toml mappers/c8y/mapper.toml; do
        exists "$MOD_DIR/$rel" || continue
        copy_into "$MOD_DIR" "$STORE.new" "$rel" && n=$((n + 1))
    done
    for d in "$MOD_DIR"/mappers/*/flows/*; do
        [ -d "$d" ] || continue
        mapper=$(basename "$(dirname "$(dirname "$d")")")
        mkdir -p "$STORE.new/mappers/$mapper/flows" 2>/dev/null || continue
        cp -a "$d" "$STORE.new/mappers/$mapper/flows/" 2>/dev/null && n=$((n + 1))
    done
    for f in "$MOD_DIR"/parameter-plugins/*; do
        [ -f "$f" ] || continue
        case "$(basename "$f")" in .*) continue ;; esac
        copy_into "$MOD_DIR" "$STORE.new" "parameter-plugins/$(basename "$f")" && n=$((n + 1))
    done
    rm -rf "$STORE"
    mv "$STORE.new" "$STORE" 2>/dev/null || mkdir -p "$STORE"
    chmod 600 "$STORE/etc/settings" 2>/dev/null || true
    log "saved $n file(s) (legacy list)"
}

# ---------------------------------------------------------------------------
# restore -- put the operator's files back into the fresh tree. Yours wins;
# where this version ships something different at the same path, it is kept
# alongside as <file>.dist so what changed stays discoverable.
# ---------------------------------------------------------------------------
restore() {
    migrate_legacy_store
    [ -d "$STORE" ] || return 0
    : > "$TMPL.raw"
    find "$STORE" -type f >> "$TMPL.raw" 2>/dev/null
    find "$STORE" -type l >> "$TMPL.raw" 2>/dev/null
    n=0
    : > "$RESTORED"
    while read -r p; do
        rel=${p#"$STORE"/}
        echo "$rel" >> "$RESTORED"
        dest=$MOD_DIR/$rel
        if exists "$dest" && ! same_file "$p" "$dest"; then
            cp -a "$dest" "$dest.dist" 2>/dev/null
            log "kept your $rel (this version ships $rel.dist)"
        fi
        # Remove first: `cp -a` will not replace an existing symlink in place.
        rm -f "$dest" 2>/dev/null
        copy_into "$STORE" "$MOD_DIR" "$rel" && n=$((n + 1))
    done < "$TMPL.raw"
    rm -f "$TMPL.raw"
    chmod 600 "$MOD_DIR/etc/settings" 2>/dev/null || true
    [ "$n" -gt 0 ] && log "restored $n file(s) across the upgrade"
    return 0
}

# A store written by <= 1.0.19 has its own layout: etc/<f>, tree/<rel>,
# flows/<mapper>/<name>/, parameter-plugins/<f>. Fold it into $STORE once, so an
# upgrade FROM such a version keeps everything it had saved.
migrate_legacy_store() {
    [ -d "$PERSIST/etc" ] || [ -d "$PERSIST/tree" ] || [ -d "$PERSIST/flows" ] \
        || [ -d "$PERSIST/parameter-plugins" ] || return 0
    log "migrating the persistent store to the per-path layout"
    for f in "$PERSIST"/etc/*; do
        [ -f "$f" ] && copy_into "$PERSIST/etc" "$STORE/etc" "$(basename "$f")"
    done
    if [ -d "$PERSIST/tree" ]; then
        : > "$TMPL.raw"
        find "$PERSIST/tree" -type f >> "$TMPL.raw" 2>/dev/null
        while read -r p; do
            copy_into "$PERSIST/tree" "$STORE" "${p#"$PERSIST"/tree/}"
        done < "$TMPL.raw"
        rm -f "$TMPL.raw"
    fi
    for d in "$PERSIST"/flows/*/*; do
        [ -d "$d" ] || continue
        mapper=$(basename "$(dirname "$d")")
        mkdir -p "$STORE/mappers/$mapper/flows" 2>/dev/null || continue
        cp -a "$d" "$STORE/mappers/$mapper/flows/" 2>/dev/null || true
    done
    for f in "$PERSIST"/parameter-plugins/*; do
        [ -f "$f" ] && copy_into "$PERSIST/parameter-plugins" "$STORE/parameter-plugins" "$(basename "$f")"
    done
    rm -rf "$PERSIST/etc" "$PERSIST/tree" "$PERSIST/flows" "$PERSIST/parameter-plugins"
    return 0
}

status() {
    echo "persistent store: $PERSIST"
    if [ -d "$STORE" ] && [ "$(count_files "$STORE")" -gt 0 ]; then
        : > "$TMPL.raw"
        find "$STORE" -type f >> "$TMPL.raw" 2>/dev/null
        find "$STORE" -type l >> "$TMPL.raw" 2>/dev/null
        # No `sort` on this firmware's busybox -- find's order will do.
        while read -r p; do echo "  yours:    ${p#"$STORE"/}"; done < "$TMPL.raw"
        rm -f "$TMPL.raw"
    else
        echo "  (nothing held yet -- run: tedge-persist save)"
    fi
    if [ -d "$BASE" ]; then
        if [ -f "$SEAL" ]; then sealed="sealed"; else sealed="not sealed yet"; fi
        echo "  baseline: $(count_files "$BASE") shipped file(s) recorded, $sealed"
    else
        echo "  baseline: none (the legacy list is used on save)"
    fi
    return 0
}

case "${1:-}" in
    baseline)      baseline ;;
    baseline-add)  baseline_add ;;
    baseline-seal) baseline_seal ;;
    save)         save ;;
    restore)      restore ;;
    status)       status ;;
    *) echo "usage: tedge-persist {baseline|baseline-add|baseline-seal|save|restore|status}" >&2; exit 2 ;;
esac
