#!/bin/sh
# Executed by ICR-OS when the Router App is removed.
MOD_DIR=/opt/tedge

# Stop thin-edge.io if it is still running.
[ -x "$MOD_DIR/etc/init" ] && "$MOD_DIR/etc/init" stop 2>/dev/null

# Remove the convenience CLI symlink (only if it points at our binary).
if [ -h /usr/bin/tedge ]; then
    LINK_TARGET=$(readlink /usr/bin/tedge 2>/dev/null)
    case "$LINK_TARGET" in
        "$MOD_DIR"/*) rm -f /usr/bin/tedge ;;
    esac
fi

# NOTE: we deliberately do NOT remove /opt/tedge-data (the persistent device
# certificate store) here. An ICR-OS upgrade runs this uninstall before
# reinstalling, so deleting it here would defeat its purpose (surviving upgrades)
# and force a Cumulocity re-registration every time. On a genuine DELETE the
# store is instead removed by its own self-cleaning guard (/opt/tedge-data/etc/init,
# written by etc/install) on the first boot after /opt/tedge is gone.

# Remove the upstream-compatibility symlink for the parameter dispatcher (only
# if it points at our script).
if [ -h /usr/bin/parameter_update.sh ]; then
    case "$(readlink /usr/bin/parameter_update.sh 2>/dev/null)" in
        "$MOD_DIR"/*) rm -f /usr/bin/parameter_update.sh ;;
    esac
fi

# Remove the /etc/tedge -> /opt/tedge config-dir symlink (only if it is ours).
if [ -L /etc/tedge ]; then
    case "$(readlink /etc/tedge 2>/dev/null)" in
        "$MOD_DIR"|"$MOD_DIR"/) rm -f /etc/tedge ;;
    esac
fi

# Remove the /etc/init.d service links (only the ones pointing back into us).
for l in /etc/init.d/S99mosquitto /etc/init.d/S99tedge-mapper-c8y /etc/init.d/S99tedge-agent; do
    [ -h "$l" ] || continue
    case "$(readlink "$l" 2>/dev/null)" in
        "$MOD_DIR"/*) rm -f "$l" ;;
    esac
done

exit 0
