#!/bin/sh
# ICR-OS service control script for the thin-edge.io Router App.
#
# ICR-OS calls this script with start|stop|restart|status|defaults to control the
# module. It provisions thin-edge.io from the module settings and supervises the
# three thin-edge.io daemons directly (no dependency on runit or the host init
# system), so it works on any ICR platform.

MOD_NAME=tedge
MOD_DIR=/opt/$MOD_NAME
BIN=$MOD_DIR/bin
MOD_DEFAULTS=$MOD_DIR/etc/defaults
MOD_SETTINGS=$MOD_DIR/etc/settings
[ -L "$MOD_SETTINGS" ] && MOD_SETTINGS=$(readlink "$MOD_SETTINGS")

# thin-edge.io environment (PATH, TEDGE_CONFIG_DIR, SSL_CERT_FILE, ...).
[ -f "$MOD_DIR/env" ] && . "$MOD_DIR/env"

# Module settings (MOD_TEDGE_*). Created from defaults on first install.
[ -f "$MOD_SETTINGS" ] || cp "$MOD_DEFAULTS" "$MOD_SETTINGS"
. "$MOD_SETTINGS"

# Log location (the per-service scripts log under /var/log/tedge).
LOGDIR=/var/log/tedge
mkdir -p "$LOGDIR" /tmp/tedge 2>/dev/null || true
MAPPER_LOG="$LOGDIR/tedge-mapper-c8y.log"

# Persistent runtime state that MUST survive a module reinstall/upgrade.
# ICR-OS replaces /opt/tedge wholesale on every Router App upgrade, so the device
# certificate cannot live under it -- otherwise every update wipes the cert and,
# with c8y-ca (the cert exists only on the device), the device drops off
# Cumulocity and needs re-registration (a truck roll). /opt is a persistent
# partition; a sibling dir OUTSIDE the module survives an upgrade because the
# boot launcher /etc/init.d/module only ever descends into /opt/<dir>/etc/init
# (and its `list` skips hyphenated names), so /opt/tedge-data is invisible to the
# module system and untouched when the tedge module is removed/replaced.
# See docs/SELF-UPDATE-ROLLBACK.md (sec 1).
PERSIST_DIR=/opt/tedge-data
CERT_DIR=$PERSIST_DIR/device-certs

log() { /usr/bin/logger -t "$MOD_NAME" "$1" 2>/dev/null; echo "$1"; }

# ---------------------------------------------------------------------------
# Service supervision
#
# The three daemons are controlled by the per-service scripts under
# services-init.d/ (device-native: pidof + kill, no start-stop-daemon and no
# runit -- neither exists on ICR-OS). Those scripts are the SINGLE start/stop
# implementation, shared by boot (this script), by thin-edge via bin/tedgectl +
# system.toml, and by direct invocation. Listed broker-first for start; stop
# walks them in reverse.
# ---------------------------------------------------------------------------
SVC_DIR="$MOD_DIR/services-init.d"
SERVICES="mosquitto tedge-mapper-c8y tedge-agent"

svc() { [ -x "$SVC_DIR/S99$2" ] && "$SVC_DIR/S99$2" "$1"; }   # svc <action> <name>

# ---------------------------------------------------------------------------
# Provisioning (idempotent, runs on every start; network steps only when needed)
# ---------------------------------------------------------------------------
normalize_url() { echo "$1" | sed -E 's|^https?://||g'; }

resolve_device_id() {
    if [ -n "$MOD_TEDGE_DEVICE_ID" ]; then
        echo "$MOD_TEDGE_DEVICE_ID"
    elif [ -x "$BIN/tedge-identity" ]; then
        "$BIN/tedge-identity" 2>/dev/null || hostname
    else
        hostname
    fi
}

# Anchor the device certificate/key on the persistent store so a module
# reinstall/upgrade never loses it. Idempotent; runs before every provisioning.
anchor_persistent_certs() {
    mkdir -p "$CERT_DIR" 2>/dev/null || true
    chmod 700 "$CERT_DIR" 2>/dev/null || true

    # One-time migration from the older in-module default location. Only helps
    # when the old cert still exists (e.g. an in-place update); a full ICR-OS
    # reinstall wipes /opt/tedge first, which is exactly why we relocate.
    old_dir=$MOD_DIR/device-certs
    if [ -f "$old_dir/tedge-certificate.pem" ] && [ ! -f "$CERT_DIR/tedge-certificate.pem" ]; then
        cp -p "$old_dir"/tedge-*.pem "$CERT_DIR"/ 2>/dev/null || true
        log "Migrated device certificate to persistent store $CERT_DIR"
    fi

    # Point tedge at the persistent cert/key (idempotent -- only write on change).
    [ "$(tedge config get device.cert_path 2>/dev/null)" = "$CERT_DIR/tedge-certificate.pem" ] \
        || tedge config set device.cert_path "$CERT_DIR/tedge-certificate.pem"
    [ "$(tedge config get device.key_path 2>/dev/null)" = "$CERT_DIR/tedge-private-key.pem" ] \
        || tedge config set device.key_path "$CERT_DIR/tedge-private-key.pem"
}

# thin-edge reads the device id from the certificate's CN, and our persistent
# cert store survives reinstalls -- so once a device has a cert it keeps that id
# (and therefore its Cumulocity name) forever, ignoring a newly-entered
# MOD_TEDGE_DEVICE_ID. If the operator EXPLICITLY sets a device id that differs
# from the current certificate's CN, treat the cert as stale and remove it so a
# fresh certificate is issued for the new id (a re-registration). Only triggers
# on an explicit, changed MOD_TEDGE_DEVICE_ID -- never when the id is derived.
drop_cert_on_id_change() {
    [ -n "$MOD_TEDGE_DEVICE_ID" ] || return 0
    cp=$(tedge config get device.cert_path 2>/dev/null)
    [ -f "$cp" ] || return 0
    current=$(tedge config get device.id 2>/dev/null)   # = cert CN while a cert exists
    if [ -n "$current" ] && [ "$current" != "$MOD_TEDGE_DEVICE_ID" ]; then
        log "Device id change requested ('$current' -> '$MOD_TEDGE_DEVICE_ID'); removing old certificate to re-register"
        rm -f "$cp" "$(tedge config get device.key_path 2>/dev/null)"
    fi
}

configure() {
    # Keep the device certificate on persistent storage (before the cert-exists
    # checks below, so an upgraded device finds its cert and skips re-download).
    anchor_persistent_certs

    # Honour an explicit device-id change by dropping a now-stale certificate.
    drop_cert_on_id_change

    # Cumulocity URL
    if [ -n "$MOD_TEDGE_C8Y_URL" ]; then
        url=$(normalize_url "$MOD_TEDGE_C8Y_URL")
        [ "$(tedge config get c8y.url 2>/dev/null)" = "$url" ] || tedge config set c8y.url "$url"
    fi

    case "$MOD_TEDGE_CA" in
        basic)
            if [ -n "$MOD_TEDGE_DEVICE_USER" ] && [ -n "$MOD_TEDGE_DEVICE_PASSWORD" ]; then
                cred_path=$(tedge config get c8y.credentials_path 2>/dev/null || echo "$MOD_DIR/credentials.toml")
                cat > "$cred_path" <<EOT
[c8y]
username = "$MOD_TEDGE_DEVICE_USER"
password = "$MOD_TEDGE_DEVICE_PASSWORD"
EOT
                chmod 600 "$cred_path" 2>/dev/null || true
                tedge config set c8y.auth_method basic
                dev_id=$(echo "$MOD_TEDGE_DEVICE_USER" | cut -d/ -f2- | sed 's|^device_||')
                [ -n "$dev_id" ] && tedge config set device.id "$dev_id"
            else
                log "ERROR: MOD_TEDGE_CA=basic but device user/password are not set"
                return 1
            fi
            ;;
        self-signed)
            tedge config set c8y.auth_method certificate
            cert_path=$(tedge config get device.cert_path 2>/dev/null)
            dev_id=$(resolve_device_id)
            [ -n "$dev_id" ] && tedge config set device.id "$dev_id"
            if [ ! -f "$cert_path" ]; then
                tedge cert create --device-id "$dev_id" || return 1
                log "Self-signed certificate created. Upload it to Cumulocity with:"
                log "  tedge cert upload c8y --user <c8y-user>"
            fi
            ;;
        *)  # c8y-ca (Cumulocity Certificate Authority) -- default & recommended
            tedge config set c8y.auth_method certificate
            dev_id=$(resolve_device_id)
            [ -n "$dev_id" ] && tedge config set device.id "$dev_id"
            cert_path=$(tedge config get device.cert_path 2>/dev/null)
            if [ ! -f "$cert_path" ]; then
                otp=$MOD_TEDGE_OTP
                # Fall back to the documented md5-of-device-id -- but only if a
                # digest tool exists. This firmware's busybox has no md5sum (nor
                # sha*sum/cksum), where this silently produced an EMPTY one-time
                # password and every registration attempt failed with no hint why.
                if [ -z "$otp" ]; then
                    if type md5sum >/dev/null 2>&1; then
                        otp=$(printf "%s" "$dev_id" | md5sum | awk '{print $1}')
                    else
                        log "ERROR: no one-time password set and md5sum is not available on this firmware;"
                        log "       set MOD_TEDGE_OTP in the module settings to the password you entered in Cumulocity."
                    fi
                fi
                c8y_host=$(tedge config get c8y.url 2>/dev/null)
                if [ -n "$c8y_host" ]; then
                    # Do NOT log the one-time password: log() writes to syslog
                    # (/var/log/messages), which is itself retrievable from the
                    # cloud via the log plugin. Log the external id only and tell
                    # the operator where the OTP comes from.
                    log "Register this device in Cumulocity (external id: $dev_id):"
                    log "  https://$c8y_host/apps/devicemanagement/index.html#/deviceregistration?externalId=$dev_id"
                    log "  Enter the one-time password from MOD_TEDGE_OTP (default: md5 of the device id); it is not logged."
                fi
                # Non-fatal: if the device is not registered / no network yet,
                # this simply retries on the next start.
                tedge cert download c8y --device-id "$dev_id" \
                    --one-time-password "$otp" --retry-every 5s --max-timeout 60s \
                    || log "Certificate not obtained yet (will retry on next start)"
            fi
            ;;
    esac

    # Keep bridge / config in sync (best effort).
    tedge config upgrade  >/dev/null 2>&1 || true
    tedge refresh-bridges >/dev/null 2>&1 || true
}

# Work around a Cumulocity c8y-ca first-connect race. On a freshly
# auto-registered device the built-in MQTT bridge sends its cloud SUBSCRIBEs
# (s/ds operations, s/dat token, devicecontrol/notifications, ...) as soon as
# it connects -- which can happen before Cumulocity has finished provisioning
# the device's authorization. Those subscriptions are then refused
# ("SubAck ... Failure") and the bridge does NOT retry them, so the mapper sits
# connected but deaf: no inbound operations and no JWT token (every REST call
# then fails 502). A fresh mapper connect once provisioning has completed clears
# it, so after starting we watch the log briefly and bounce the mapper if we see
# the refusal. Healthy connections return quickly; this only adds latency (and
# restarts) on a genuinely racing first boot.
heal_mapper_subscriptions() {
    max_restarts=3
    restarts=0
    mark=$(wc -l < "$MAPPER_LOG" 2>/dev/null || echo 0)
    waited=0
    while [ "$waited" -lt 90 ]; do
        sleep 3
        waited=$((waited + 3))
        new=$(awk -v n="$mark" 'NR>n' "$MAPPER_LOG" 2>/dev/null)

        if echo "$new" | grep -Eq "\[cloud\].*SubAck.*Failure"; then
            if [ "$restarts" -ge "$max_restarts" ]; then
                log "cloud bridge still refusing subscriptions after $restarts restarts; will retry on next start"
                return 0
            fi
            restarts=$((restarts + 1))
            log "cloud bridge subscriptions refused (c8y provisioning not ready); restarting mapper ($restarts/$max_restarts)"
            svc restart tedge-mapper-c8y
            mark=$(wc -l < "$MAPPER_LOG" 2>/dev/null || echo 0)
            waited=0
            continue
        fi

        # A received JWT token proves the s/dat subscription was accepted, which
        # only happens once the operational topics are authorized too.
        if echo "$new" | grep -q "JWT token received"; then
            log "cloud bridge healthy (operations and token channel up)"
            return 0
        fi
    done
    return 0
}

# ---------------------------------------------------------------------------
# System metrics poller (optional, enabled by default)
#
# metrics-monitor publishes router metrics (CPU load, memory, disk, board
# temperature/voltage) to the local bus as Cumulocity measurements. There is no
# separate Router App: the poller ships with the platform module and is started
# here when configured. Its config lives in etc/metrics (registered with the
# configuration plugin; MOD_METRICS_* -- no secrets), read fresh here so an
# operator can enable/disable it without editing the main settings file.
# ---------------------------------------------------------------------------
METRICS_CONF="$MOD_DIR/etc/metrics"
METRICS_PROC=metrics-monitor   # the poller's process name (comm); pidof matches it

metrics_enabled() {
    [ -f "$METRICS_CONF" ] || return 1
    enabled=$(. "$METRICS_CONF"; echo "${MOD_METRICS_ENABLED:-1}")
    [ "$enabled" = "1" ]
}

metrics_running() { pidof "$METRICS_PROC" >/dev/null 2>&1; }

# Device-native stop: ICR-OS busybox has no pkill/start-stop-daemon, so match by
# comm with pidof and kill (the same pattern as the S99 service scripts).
stop_metrics() {
    metrics_running || return 0
    kill $(pidof "$METRICS_PROC") 2>/dev/null
}

start_metrics() {
    metrics_enabled || { log "metrics poller disabled (set MOD_METRICS_ENABLED=1 in etc/metrics)"; return 0; }
    stop_metrics   # never leave two pollers running after a restart
    "$BIN/metrics-monitor" >> "$LOGDIR/metrics-monitor.log" 2>&1 &
    log "metrics poller started"
}

# ---------------------------------------------------------------------------
# Relay (digital output) control (optional, enabled by default)
#
# Drives the router's digital outputs from Cumulocity via the c8y_Relay /
# c8y_RelayArray operations (handled by bin/relay-c8y-op, declared in
# operations/c8y/). relay-seed publishes the initial widget state (retries then
# exits); relay-monitor reflects device-side output changes back to Cumulocity.
# Config in etc/relay (registered with the configuration plugin; no secrets).
# Same device-native stop as the metrics poller -- pidof + kill, never pkill.
# ---------------------------------------------------------------------------
RELAY_CONF="$MOD_DIR/etc/relay"

relay_enabled() {
    [ -f "$RELAY_CONF" ] || return 1
    enabled=$(. "$RELAY_CONF"; echo "${MOD_RELAY_ENABLED:-0}")
    [ "$enabled" = "1" ]
}

relay_running() { pidof relay-monitor >/dev/null 2>&1; }

stop_relay() {
    for p in relay-monitor relay-seed; do
        pidof "$p" >/dev/null 2>&1 && kill $(pidof "$p") 2>/dev/null
    done
}

start_relay() {
    relay_enabled || { log "relay disabled (set MOD_RELAY_ENABLED=1 in etc/relay)"; return 0; }
    stop_relay   # never leave two monitors/seeders after a restart
    "$BIN/relay-seed"    >> "$LOGDIR/relay-seed.log" 2>&1 &
    "$BIN/relay-monitor" >> "$LOGDIR/relay-monitor.log" 2>&1 &
    outs=$(. "$RELAY_CONF"; echo "${MOD_RELAY_OUTPUTS:-out0}")
    log "relay started (outputs: $outs)"
}

# ---------------------------------------------------------------------------
# Container plugin monitoring daemon (optional, enabled by default)
#
# `tedge-container run` watches the container engine and reports the status +
# telemetry of managed containers to Cumulocity as services. The container /
# container-group software-management plugins (sm-plugins/, wired by etc/install)
# work independently of this daemon -- they are invoked on demand by tedge-agent
# for Cumulocity software operations. The container engine on ICR-OS is provided
# by the separately-installed Advantech Docker Router App (another /opt/<module>),
# so the monitor is started ONLY when that app is detected; otherwise it is
# skipped (a router without it still installs cleanly). Config in etc/container
# (gate) + the plugin .toml. Same device-native stop as the other pollers --
# pidof + kill, never pkill.
# ---------------------------------------------------------------------------
CONTAINER_CONF="$MOD_DIR/etc/container"
CONTAINER_TOML="$MOD_DIR/plugins/tedge-container-plugin.toml"
CONTAINER_PROC=tedge-container   # the daemon's process name (comm); pidof matches it
DOCKER_APP_DIR=/opt/docker       # the Advantech Docker Router App's install dir

container_enabled() {
    [ -f "$CONTAINER_CONF" ] || return 1
    enabled=$(. "$CONTAINER_CONF"; echo "${MOD_CONTAINER_ENABLED:-1}")
    [ "$enabled" = "1" ]
}

# Detect the container engine. On ICR-OS it is supplied by the Advantech Docker
# Router App, installed as its own /opt/docker module -- so its presence is the
# signal that a container engine is available. An explicit engine host set in the
# [container] section of the plugin .toml overrides this (scoped with awk so it
# is not confused with the [client] host = "127.0.0.1" entries).
docker_app_present() {
    if [ -f "$CONTAINER_TOML" ]; then
        host=$(awk '
            /^[[:space:]]*\[/ { insec = ($0 ~ /^[[:space:]]*\[container\][[:space:]]*$/) }
            insec && /^[[:space:]]*host[[:space:]]*=/ {
                sub(/^[^=]*=[[:space:]]*/, ""); gsub(/"/, ""); print; exit
            }' "$CONTAINER_TOML")
        [ -n "$host" ] && return 0
    fi
    [ -d "$DOCKER_APP_DIR" ]
}

container_running() { pidof "$CONTAINER_PROC" >/dev/null 2>&1; }

stop_container() {
    container_running || return 0
    kill $(pidof "$CONTAINER_PROC") 2>/dev/null
}

# Wait for tedge-agent's local HTTP API (te/v1/entities) to accept connections.
# The plugin registers its container services there on startup; if it launches
# before the agent has bound the port it logs a burst of "connection refused"
# and defers the initial sync to the 30m reconcile. Poll the listening socket
# (netstat -- busybox has no curl/nc here) for a bounded time, then start
# regardless (the plugin still retries). Port from http.client.port (default 8000).
wait_agent_http() {
    port=$(tedge config get http.client.port 2>/dev/null); [ -n "$port" ] || port=8000
    i=0
    while [ "$i" -lt 30 ]; do
        netstat -ltn 2>/dev/null | grep -qE "[.:]$port[[:space:]]" && return 0
        sleep 1
        i=$((i + 1))
    done
    log "container monitor: tedge-agent HTTP (:$port) not ready after ${i}s; starting anyway"
    return 0
}

start_container() {
    [ -x "$BIN/tedge-container" ] || return 0
    container_enabled || { log "container monitor disabled (set MOD_CONTAINER_ENABLED=1 in etc/container)"; return 0; }
    if ! docker_app_present; then
        log "container monitor: Advantech Docker Router App not detected ($DOCKER_APP_DIR); not starting"
        return 0
    fi
    stop_container   # never leave two daemons running after a restart
    wait_agent_http  # avoid a startup race with the agent's local HTTP API
    # The Docker Router App keeps its CLIs (docker, docker-compose) under
    # /opt/docker/bin, which is not on the default PATH; prepend it so any CLI
    # shell-out resolves (the daemon otherwise talks to /var/run/docker.sock).
    PATH="$DOCKER_APP_DIR/bin:$PATH" \
        "$BIN/tedge-container" run --config "$CONTAINER_TOML" >> "$LOGDIR/tedge-container.log" 2>&1 &
    log "container monitor started"
}

# ---------------------------------------------------------------------------
# Device parameters (optional, enabled by default)
#
# Implements Cumulocity's c8y_ParameterUpdate operation: the workflow
# operations/parameter_update.toml + the dispatcher bin/parameter-update hand an
# incoming parameter set to the matching script in parameter-plugins/, which
# writes this module's own config (etc/metrics, etc/relay, etc/container) and
# reloads that feature. bin/parameter-seed publishes the current values as
# retained twin data at start so the cloud shows the router's real state; it
# exits once done (not a daemon), like relay-seed. Config in etc/parameters.
# ---------------------------------------------------------------------------
PARAM_CONF="$MOD_DIR/etc/parameters"

parameters_enabled() {
    [ -f "$PARAM_CONF" ] || return 1
    enabled=$(. "$PARAM_CONF"; echo "${MOD_PARAMETERS_ENABLED:-1}")
    [ "$enabled" = "1" ]
}

stop_parameters() {
    pidof parameter-seed >/dev/null 2>&1 && kill $(pidof parameter-seed) 2>/dev/null
    return 0
}

start_parameters() {
    parameters_enabled || { log "device parameters disabled (set MOD_PARAMETERS_ENABLED=1 in etc/parameters)"; return 0; }
    stop_parameters   # never leave two seeders running after a restart
    "$BIN/parameter-seed" >> "$LOGDIR/parameter-seed.log" 2>&1 &
    sets=$(. "$PARAM_CONF"; echo "${MOD_PARAMETERS_SETS:-}")
    log "device parameters enabled (sets: $sets)"
}

start_tedge() {
    log "Starting $MOD_NAME"

    # Create runtime dirs and the tedge multi-call symlinks (tedge-mapper,
    # tedge-agent, ...). Idempotent.
    "$BIN/tedge" init --user root --group root >/dev/null 2>&1 || true

    configure || { log "Provisioning failed; not starting daemons"; return 1; }

    # Start the local MQTT broker first.
    svc start mosquitto

    # Bring up the Cumulocity link via thin-edge's own `tedge connect c8y`, the
    # way the stock bundle's bootstrap does. connect creates the device in
    # Cumulocity with its proper name/type (a direct, certificate-authenticated
    # REST call) BEFORE any telemetry, then brings up the built-in bridge and
    # starts the mapper -- so Cumulocity does not auto-register the device as
    # "MQTT Device <id>". Idempotent via reconnect. If it fails (no network / not
    # yet registered), start the mapper directly so we still run and retry.
    if tedge reconnect c8y >/dev/null 2>&1; then
        log "connected to Cumulocity (device created/verified by tedge connect)"
    else
        log "tedge connect c8y failed; starting mapper directly (will retry next boot)"
        svc start tedge-mapper-c8y
    fi

    # Device management agent.
    svc start tedge-agent

    # System metrics poller (enabled by default; gated by etc/metrics).
    start_metrics

    # Relay control: seed the widget + start the reflector (gated by etc/relay).
    start_relay

    # Container monitoring daemon (gated by etc/container + engine presence).
    start_container

    # Device parameters: seed the current values for the cloud (gated by
    # etc/parameters). The operation itself needs no daemon.
    start_parameters

    log "$MOD_NAME started"

    # Self-heal the c8y-ca first-connect subscription race (see the function).
    heal_mapper_subscriptions
}

stop_tedge() {
    log "Stopping $MOD_NAME"
    # Keep the upgrade-safe copy of the operator's flows and feature configs
    # current (bin/tedge-persist). etc/uninstall does this too; doing it on every
    # stop means an upgrade that skips uninstall still finds a recent copy.
    [ -x "$BIN/tedge-persist" ] && "$BIN/tedge-persist" save >/dev/null 2>&1
    stop_parameters
    stop_container
    stop_relay
    stop_metrics
    svc stop tedge-agent
    svc stop tedge-mapper-c8y
    svc stop mosquitto
}

status_tedge() {
    rc=0
    for s in $SERVICES; do
        if "$SVC_DIR/S99$s" status >/dev/null 2>&1; then
            echo "  $s: running"
        else
            echo "  $s: stopped"
            rc=1
        fi
    done
    if metrics_enabled; then
        if metrics_running; then echo "  metrics-monitor: running"; else echo "  metrics-monitor: stopped"; fi
    else
        echo "  metrics-monitor: disabled"
    fi
    if relay_enabled; then
        if relay_running; then echo "  relay-monitor: running"; else echo "  relay-monitor: stopped"; fi
    else
        echo "  relay-monitor: disabled"
    fi
    if container_enabled; then
        if container_running; then echo "  tedge-container: running"; else echo "  tedge-container: stopped"; fi
    else
        echo "  tedge-container: disabled"
    fi
    # Parameters need no daemon (the seeder exits once it has published), so
    # report the feature state rather than a process state.
    if parameters_enabled; then
        echo "  parameters: enabled ($(. "$PARAM_CONF"; echo "${MOD_PARAMETERS_SETS:-none}"))"
    else
        echo "  parameters: disabled"
    fi
    return $rc
}

case "$1" in
    start)
        [ "$MOD_TEDGE_ENABLED" = "1" ] || { echo "$MOD_NAME is disabled (set MOD_TEDGE_ENABLED=1)"; exit 0; }
        start_tedge
        ;;
    stop)
        stop_tedge
        ;;
    restart)
        stop_tedge
        sleep 1
        [ "$MOD_TEDGE_ENABLED" = "1" ] || { echo "$MOD_NAME is disabled (set MOD_TEDGE_ENABLED=1)"; exit 0; }
        start_tedge
        ;;
    apply)
        # Invoked by the web UI after saving settings. A full restart takes ~30s
        # (tedge connect + first-connect heal), which would block the CGI request
        # and leave the browser on an empty/timed-out page. Kick the restart off
        # in the background and return immediately; the UI reflects the new state
        # once the service has settled.
        nohup "$MOD_DIR/etc/init" restart >>"$LOGDIR/apply.log" 2>&1 &
        echo "Configuration saved. thin-edge.io is restarting in the background."
        ;;
    reload)
        # Restart a single built-in feature without bouncing the whole module
        # (a full restart re-runs tedge connect and takes ~30 s). Used by the
        # parameter plugins after they have written a new value, and handy for
        # an operator who changed one of the etc/* config files over SSH.
        case "${2:-}" in
            metrics)   stop_metrics;    start_metrics ;;
            relay)     stop_relay;      start_relay ;;
            container) stop_container;  start_container ;;
            parameters) stop_parameters; start_parameters ;;
            *) echo "Usage: $0 reload {metrics|relay|container|parameters}" >&2; exit 1 ;;
        esac
        ;;
    status)
        echo "Module $MOD_NAME:"
        status_tedge
        exit $?
        ;;
    upload-cert)
        # Upload the router's self-signed device certificate to Cumulocity's
        # trusted certificates. Invoked from the web UI (source/module_cgi.c).
        # The Cumulocity user comes from $MOD_TEDGE_C8Y_USER and the password
        # from $C8Y_PASSWORD (read by tedge), both set in the environment by the
        # caller so they never appear in the process list or logs.
        "$BIN/tedge" init --user root --group root >/dev/null 2>&1 || true
        if [ -n "$MOD_TEDGE_C8Y_URL" ]; then
            url=$(normalize_url "$MOD_TEDGE_C8Y_URL")
            [ "$(tedge config get c8y.url 2>/dev/null)" = "$url" ] || tedge config set c8y.url "$url"
        fi
        if [ -z "$MOD_TEDGE_C8Y_USER" ]; then
            echo "ERROR: no Cumulocity user provided"; exit 1
        fi
        if [ -z "$C8Y_PASSWORD" ]; then
            echo "ERROR: no Cumulocity password provided"; exit 1
        fi
        cert_path=$(tedge config get device.cert_path 2>/dev/null)
        if [ -n "$cert_path" ] && [ ! -f "$cert_path" ]; then
            echo "ERROR: no device certificate found at $cert_path."
            echo "Set the registration mode to self-signed, enable the service and"
            echo "(re)start it to create a certificate, then upload it here."
            exit 1
        fi
        echo "Uploading certificate to Cumulocity as user '$MOD_TEDGE_C8Y_USER'..."
        if tedge cert upload c8y --user "$MOD_TEDGE_C8Y_USER"; then
            echo "Certificate uploaded successfully."
        else
            rc=$?
            echo "Certificate upload failed (exit $rc)."
            exit "$rc"
        fi
        ;;
    defaults)
        cp "$MOD_DEFAULTS" "$MOD_SETTINGS"
        echo "Settings reset to defaults"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload <feature>|status|upload-cert|defaults}"
        exit 1
        ;;
esac
